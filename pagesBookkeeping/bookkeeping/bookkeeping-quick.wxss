.quick-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 10rpx 20rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.category-selector {
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-bottom: 28rpx;
  background: #ad9700;
}

.category-item {
  flex: 1;
  height: 82rpx;
  color: #111;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 82rpx;
  text-align: center;
}

.category-item.active {
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 10rpx;
  text-decoration-thickness: 4rpx;
}

.voice-float-wrap {
  position: fixed;
  z-index: 45;
  right: 32rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 520rpx;
}

.voice-fab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 44rpx;
  background: #222222;
  color: #f4d44d;
  box-sizing: border-box;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.22);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  white-space: nowrap;
}

.voice-fab::after {
  border: 0;
}

.voice-fab.recording {
  background: #b33a3a;
  color: #ffffff;
}

.voice-fab[disabled] {
  background: #8f8f8f;
  color: #ffffff;
}

.voice-recording-panel {
  width: 320rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.voice-recording-status {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.voice-recording-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #d84040;
  animation: voice-recording-pulse 1s ease-in-out infinite;
}

.voice-recording-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.voice-recording-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.voice-recording-btn::after {
  border: 0;
}

.voice-recording-btn.cancel {
  background: #f0f0f0;
  color: #444444;
}

.voice-recording-btn.submit {
  background: #222222;
  color: #f4d44d;
}

@keyframes voice-recording-pulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.86);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.voice-float-result {
  max-width: 520rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #333333;
  font-size: 26rpx;
  line-height: 1.45;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.voice-text,
.voice-message {
  display: block;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.voice-message {
  margin-top: 6rpx;
  color: #666666;
}

.actions-list {
  display: flex;
  flex-wrap: wrap;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  min-width: 0;
  margin-bottom: 38rpx;
  box-sizing: border-box;
}

.icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
}

.icon-wrapper.selected {
  background: #ad9700;
}

.action-icon {
  width: 42rpx;
  height: 42rpx;
  filter: grayscale(100%);
  opacity: 0.72;
}

.icon-wrapper.selected .action-icon {
  filter: none;
  opacity: 1;
}

.action-text {
  max-width: 150rpx;
  color: #222;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

.dim-mask {
  position: fixed;
  z-index: 50;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.34);
}

.bookkeeping-panel {
  position: fixed;
  z-index: 60;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
}

.amount-display {
  height: 78rpx;
  padding: 0 36rpx;
  color: #222;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: right;
}

.remark-row {
  display: flex;
  align-items: center;
  height: 74rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid #eeeeee;
  border-bottom: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.remark-label {
  flex: none;
  margin-right: 28rpx;
  color: #666;
  font-size: 28rpx;
}

.remark-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #333;
  font-size: 28rpx;
}

.voice-draft-row {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eeeeee;
  box-sizing: border-box;
  background: #ffffff;
}

.voice-draft-label {
  flex: none;
  margin-right: 28rpx;
  color: #666666;
  font-size: 28rpx;
}

.voice-draft-picker-wrap {
  flex: 1;
  min-width: 0;
}

.voice-draft-picker {
  height: 76rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 76rpx;
}

.voice-draft-picker.placeholder {
  color: #999999;
}

.file-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.more-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #eeeeee;
  color: #333;
  font-size: 30rpx;
  line-height: 1.2;
  box-sizing: border-box;
}

.more-row:last-child {
  border-bottom: 0;
}

.more-row switch {
  transform: scale(0.86);
  transform-origin: right center;
}

.attachment-row {
  align-items: center;
  min-height: 118rpx;
}

.attachment-row > text {
  flex: none;
  margin-right: 24rpx;
}

.attachment-row .file-list {
  flex: 1;
  justify-content: flex-end;
  gap: 14rpx;
  min-width: 0;
}

.file-item,
.upload-entry {
  position: relative;
  width: 118rpx;
  height: 72rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.file-thumbnail {
  width: 100%;
  height: 100%;
}

.delete-file {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
}

.upload-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 160rpx;
  border: 1rpx solid #cccccc;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
  line-height: 72rpx;
}

.number-keyboard {
  display: flex;
  flex-direction: column;
  width: 100%;
  border-top: 1rpx solid #dddddd;
  box-sizing: border-box;
}

.keyboard-row {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

.key-btn {
  display: flex;
  flex: 0 0 25%;
  align-items: center;
  justify-content: center;
  width: 25%;
  max-width: 25%;
  min-width: 0;
  height: 100rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-right: 1rpx solid #dddddd;
  border-bottom: 1rpx solid #dddddd;
  border-radius: 0;
  background: #ffffff;
  color: #111;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 100rpx;
  text-align: center;
  box-sizing: border-box;
}

.key-btn::after {
  border: 0;
}

.keyboard-row .key-btn:last-child {
  border-right: 0;
}

.function-key,
.date-key {
  background: #f8f8f8;
  color: #333;
  font-size: 30rpx;
}

.date-key-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.calendar-icon {
  margin-right: 4rpx;
  font-size: 30rpx;
}

.submit-key {
  background: #ffd400;
  color: #111;
  font-size: 34rpx;
  font-weight: 500;
}

.submit-key.submitting,
.submit-key[disabled] {
  background: #e8e0a8;
  color: #666666;
}

.submit-status-mask {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.58);
}

.submit-status-card {
  display: flex;
  align-items: center;
  min-width: 220rpx;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  background: rgba(34, 34, 34, 0.92);
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.submit-status-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.36);
  border-top-color: #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  animation: submit-status-spin 0.8s linear infinite;
}

.submit-status-text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

@keyframes submit-status-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.option-mask {
  position: fixed;
  z-index: 70;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
}

.option-popup {
  position: fixed;
  z-index: 80;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 34rpx 40rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 20rpx 20rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.tags-popup {
  max-height: 520rpx;
  overflow-y: auto;
}

.more-popup {
  max-height: 660rpx;
  overflow-y: auto;
}

.popup-empty {
  padding: 34rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.tag-checkbox-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 8rpx;
  row-gap: 18rpx;
}

.tag-checkbox-item {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #666666;
  font-size: 28rpx;
  line-height: 38rpx;
}

.tag-checkbox-box {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border: 2rpx solid #d9dde6;
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.tag-checkbox-item.selected .tag-checkbox-box {
  border-color: #2f7cff;
  background: #2f7cff;
}

.tag-checkbox-item.selected .tag-checkbox-text {
  color: #2f7cff;
}

.tag-checkbox-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.currency-picker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 66rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d6d6d6;
  border-radius: 8rpx;
  background: #ffffff;
  color: #777777;
  font-size: 28rpx;
  line-height: 66rpx;
  box-sizing: border-box;
}

.currency-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  margin-top: -6rpx;
  border-right: 3rpx solid #888888;
  border-bottom: 3rpx solid #888888;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.upload-mask {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.18);
}

.upload-popup {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  border-radius: 18rpx 18rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.upload-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 0 0 12rpx;
  border-radius: 10rpx;
  background: #f7f7f7;
  color: #222;
  font-size: 30rpx;
  line-height: 76rpx;
}

.upload-option.cancel {
  margin-bottom: 0;
  color: #888;
}

.upload-option::after {
  border: 0;
}
