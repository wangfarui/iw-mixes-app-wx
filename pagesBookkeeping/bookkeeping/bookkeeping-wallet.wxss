.wallet-page {
  min-height: 100vh;
  padding: 20rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.wallet-card,
.records-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.wallet-card {
  display: flex;
  align-items: center;
}

.amount-item {
  flex: 1;
  text-align: center;
}

.amount-label {
  color: #666;
  font-size: 26rpx;
}

.amount-value {
  margin: 12rpx 0 16rpx;
  color: #222;
  font-size: 42rpx;
  font-weight: 700;
  white-space: nowrap;
}

.update-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 28rpx;
  border: 1rpx solid #dddddd;
  border-radius: 24rpx;
  color: #666;
  font-size: 24rpx;
}

.divider {
  width: 1rpx;
  height: 82rpx;
  margin: 0 24rpx;
  background: #eeeeee;
}

.type-tabs,
.mode-tabs,
.record-item,
.modal-actions {
  display: flex;
  align-items: center;
}

.type-tabs,
.mode-tabs {
  padding: 6rpx;
  border-radius: 12rpx;
  background: #f0f1f3;
}

.tab-item,
.mode-item {
  flex: 1;
  height: 60rpx;
  border-radius: 10rpx;
  color: #666;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 60rpx;
  text-align: center;
}

.tab-item.active,
.mode-item.active {
  background: #ffffff;
  color: #07c160;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.record-item {
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-of-type {
  border-bottom: 0;
}

.change-amount {
  color: #f56c6c;
  font-size: 32rpx;
  font-weight: 700;
}

.change-amount.increase {
  color: #07c160;
}

.record-time,
.amount-info {
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.amount-info {
  text-align: right;
  line-height: 1.6;
}

.load-more {
  padding: 28rpx 0 6rpx;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.modal-mask {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
}

.modal-card {
  width: 86vw;
  padding: 32rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.modal-title {
  margin-bottom: 24rpx;
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.amount-input {
  height: 78rpx;
  margin-top: 28rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 28rpx;
  line-height: 78rpx;
  box-sizing: border-box;
}

.modal-actions {
  gap: 18rpx;
  margin-top: 32rpx;
}

.modal-actions button {
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.modal-actions button::after {
  border: 0;
}

.cancel-btn {
  background: #f0f1f3;
  color: #555;
}

.confirm-btn {
  background: #07c160;
  color: #ffffff;
}
