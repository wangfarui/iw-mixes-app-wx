.action-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.status-warning {
  margin-bottom: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background: #fff0f0;
  color: #f56c6c;
  font-size: 26rpx;
  font-weight: 600;
}

.segment-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.segment-item {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  color: #666;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.segment-item.active {
  background: #07c160;
  color: #ffffff;
}

.form-card,
.today-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-row:last-child,
.form-block:last-child {
  margin-bottom: 0;
}

.form-block {
  margin-bottom: 24rpx;
}

.label {
  flex: none;
  width: 150rpx;
  margin-right: 20rpx;
  color: #666;
  font-size: 27rpx;
  text-align: right;
}

.block-label {
  width: auto;
  margin: 0 0 14rpx;
  text-align: left;
}

.input,
.picker-box,
.icon-selector {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 28rpx;
  line-height: 76rpx;
}

.amount-input {
  font-size: 34rpx;
  font-weight: 700;
}

.switch-row {
  justify-content: space-between;
}

.icon-selector {
  position: relative;
  display: flex;
  align-items: center;
}

.selected-icon {
  width: 48rpx;
  height: 48rpx;
}

.placeholder {
  color: #999;
}

.clear-icon {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f56c6c;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
}

.tag-group,
.file-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 24rpx;
}

.tag-chip.selected {
  background: #e9f8ef;
  color: #07c160;
  font-weight: 600;
}

.file-item,
.upload-entry {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: 12rpx;
}

.file-thumbnail {
  width: 100%;
  height: 100%;
}

.delete-file {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 36rpx;
  text-align: center;
}

.upload-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed #d8dde3;
  color: #999;
  font-size: 24rpx;
}

.save-button {
  position: fixed;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 44rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.save-button::after,
.upload-panel button::after {
  border: 0;
}

.today-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.today-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 700;
}

.today-total {
  color: #ff6b35;
  font-size: 24rpx;
}

.today-item {
  display: grid;
  grid-template-columns: 1fr auto;
  row-gap: 4rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.today-source {
  min-width: 0;
  max-width: 100%;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 38rpx;
  white-space: normal;
  word-break: break-all;
  word-wrap: break-word;
}

.today-amount {
  white-space: nowrap;
  color: #333;
  font-size: 28rpx;
  font-weight: 700;
}

.today-time {
  grid-column: 1 / 3;
  color: #999;
  font-size: 24rpx;
}

.empty {
  padding: 36rpx 0 12rpx;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.popup-mask,
.upload-mask {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
}

.popup-mask {
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-popup {
  width: 90vw;
  max-height: 80vh;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
}

.popup-close {
  color: #999;
  font-size: 44rpx;
  line-height: 1;
}

.icon-list {
  max-height: calc(80vh - 100rpx);
  box-sizing: border-box;
  padding: 24rpx;
}

.icon-category {
  margin-bottom: 28rpx;
}

.category-title {
  margin-bottom: 16rpx;
  color: #666;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.category-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f7f8fa;
}

.icon-item.selected {
  background: #e9f8ef;
}

.icon-image {
  width: 40rpx;
  height: 40rpx;
}

.upload-mask {
  display: flex;
  align-items: flex-end;
}

.upload-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.upload-panel button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 28rpx;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.upload-panel .cancel {
  color: #999;
}
