<view class="year-page">
  <view class="year-header">
    <picker mode="date" fields="year" value="{{selectedYearDate}}" bindchange="onYearChange">
      <view class="year-picker">{{selectedYear}}年</view>
    </picker>
    <view class="year-tabs">
      <view class="year-tab {{currentTab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="switchTab">总览</view>
      <view class="year-tab {{currentTab === 'consume' ? 'active' : ''}}" data-tab="consume" bindtap="switchTab">支出</view>
      <view class="year-tab {{currentTab === 'income' ? 'active' : ''}}" data-tab="income" bindtap="switchTab">收入</view>
    </view>
  </view>

  <view class="setting-card">
    <text>忽略不计入统计的账单</text>
    <switch checked="{{ignoreNotStatistics}}" bindchange="switchIgnoreStatistics" />
  </view>

  <view wx:if="{{currentTab === 'overview'}}">
    <view class="summary-grid">
      <view class="summary-card consume">
        <view class="summary-label">年度支出</view>
        <view class="summary-amount">¥{{overview.yearStatistics.totalConsume}}</view>
        <view class="summary-sub">{{overview.yearStatistics.consumeCount}} 笔</view>
      </view>
      <view class="summary-card income">
        <view class="summary-label">年度收入</view>
        <view class="summary-amount">¥{{overview.yearStatistics.totalIncome}}</view>
        <view class="summary-sub">{{overview.yearStatistics.incomeCount}} 笔</view>
      </view>
    </view>

    <view class="section-card net-card">
      <text class="section-title">年度净收入</text>
      <text class="net-amount {{overview.yearStatistics.netIncomeRaw >= 0 ? 'positive' : 'negative'}}">{{overview.yearStatistics.netIncomePrefix}}¥{{overview.yearStatistics.netIncome}}</text>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">年度趋势分析</view>
          <view class="section-subtitle">{{overview.trendChart.summary}}</view>
        </view>
      </view>
      <view class="trend-legend">
        <view class="trend-legend-item"><view class="legend-dot consume-dot"></view><text>支出</text></view>
        <view class="trend-legend-item"><view class="legend-dot income-dot"></view><text>收入</text></view>
        <view class="trend-legend-item"><view class="legend-dot net-dot"></view><text>净收入</text></view>
      </view>
      <canvas id="yearTrendCanvas" canvas-id="yearTrendCanvas" class="trend-canvas"></canvas>
      <view wx:if="{{overview.trendChart.negativeMonthsText}}" class="negative-months">
        <text class="negative-label">净收入为负</text>
        <text class="negative-text">{{overview.trendChart.negativeMonthsText}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">记账习惯分析</view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-value-line">
            <text class="metric-value">{{overview.recordingHabits.recordingDays}}</text>
            <text class="metric-unit">天</text>
          </view>
          <view class="metric-label">记账天数</view>
        </view>
        <view class="metric-item">
          <view class="metric-value-line">
            <text class="metric-value">{{overview.recordingHabits.maxContinuousDays}}</text>
            <text class="metric-unit">天</text>
          </view>
          <view class="metric-label">连续记账最长</view>
        </view>
        <view class="metric-item">
          <view class="metric-value-line">
            <text class="metric-value month-value">{{overview.recordingHabits.peakMonth}}</text>
            <text class="metric-count-inline">({{overview.recordingHabits.peakCount}}次)</text>
          </view>
          <view class="metric-label">记账次数最多</view>
        </view>
      </view>
      <view class="detail-row"><text>全年记账次数</text><text>{{overview.recordingHabits.recordingCount}}</text></view>
      <view class="detail-row"><text>平均每天记账次数</text><text>{{overview.recordingHabits.avgPerDay}}次</text></view>
      <view class="detail-row"><text>遗漏次数</text><text>{{overview.recordingHabits.missingCount}}次</text></view>
      <view class="detail-row"><text>遗漏率</text><text>{{overview.recordingHabits.missingRate}}%</text></view>
      <view class="evaluation">{{overview.recordingHabits.evaluation}}</view>
    </view>
  </view>

  <view wx:elif="{{currentTab === 'consume'}}">
    <view class="summary-card single consume">
      <view class="summary-label">年度支出</view>
      <view class="summary-amount">¥{{consume.yearStatistics.totalConsume}}</view>
      <view class="summary-sub">共 {{consume.yearStatistics.consumeCount}} 笔</view>
    </view>

    <view class="section-card">
      <view class="section-title">每月支出趋势</view>
      <view class="month-bar" wx:for="{{consume.monthlyList}}" wx:key="month">
        <text class="month-label">{{item.month}}</text>
        <view class="progress-track"><view class="progress-fill consume-fill" style="width: {{item.ratio}}%"></view></view>
        <text class="progress-money">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">支出分类占比</view>
      <view class="progress-item" wx:for="{{consume.consumeCategories}}" wx:key="name">
        <view class="progress-head"><text>{{item.name}}</text><text>¥{{item.amount}}</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{item.ratio}}%; background: {{item.color}}"></view></view>
        <view class="progress-foot">{{item.ratio}}%</view>
      </view>
      <view wx:if="{{consume.hasMoreCategory}}" class="expand-btn" bindtap="toggleCategory">{{showAllCategory ? '收起' : '展开全部'}}</view>
      <view wx:if="{{!consume.consumeCategories.length}}" class="empty">暂无分类数据</view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">支出标签占比</text>
        <text class="mini-btn" bindtap="switchTagViewType">{{tagViewTypeText}}</text>
      </view>
      <view class="progress-item" wx:for="{{consume.consumeTags}}" wx:key="name">
        <view class="progress-head"><text>{{item.name}}</text><text>{{item.displayText}}</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{item.displayRatio}}%; background: {{item.color}}"></view></view>
      </view>
      <view wx:if="{{consume.hasMoreTags}}" class="expand-btn" bindtap="toggleTags">{{showAllTags ? '收起' : '展开全部'}}</view>
      <view wx:if="{{!consume.consumeTags.length}}" class="empty">暂无标签数据</view>
    </view>

    <view class="section-card">
      <view class="section-title">支出 Top10</view>
      <view class="rank-item" wx:for="{{consume.topConsumeList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="rank-index">{{index + 1}}</view>
        <view class="rank-main">
          <view class="rank-title">{{item.category}}</view>
          <view class="rank-desc">{{item.description}}</view>
          <view class="rank-meta">{{item.date}}{{item.ownerText}}</view>
        </view>
        <view class="rank-amount">¥{{item.amount}}</view>
      </view>
      <view wx:if="{{!consume.topConsumeList.length}}" class="empty">暂无支出记录</view>
    </view>

    <view class="section-card">
      <view class="section-title">支出洞察</view>
      <view class="insight-grid">
        <view class="insight-item"><text>支出最高的一天</text><text>¥{{consume.insights.maxDayAmount}}</text><text>{{consume.insights.maxDayDate}}</text></view>
        <view class="insight-item"><text>支出最高的月份</text><text>¥{{consume.insights.maxMonthAmount}}</text><text>{{consume.insights.maxMonthName}}</text></view>
        <view class="insight-item"><text>最常用支出标签</text><text>{{consume.insights.topTag}}</text><text>{{consume.insights.topTagCount}}次</text></view>
        <view class="insight-item"><text>月均支出</text><text>¥{{consume.insights.avgMonthAmount}}</text><text>12月平均</text></view>
      </view>
    </view>
  </view>

  <view wx:else>
    <view class="summary-card single income">
      <view class="summary-label">年度收入总额</view>
      <view class="summary-amount">¥{{income.yearStatistics.totalIncome}}</view>
      <view class="summary-sub">共 {{income.yearStatistics.incomeCount}} 笔</view>
    </view>

    <view class="section-card">
      <view class="section-title">每月收入趋势</view>
      <view class="month-bar" wx:for="{{income.monthlyList}}" wx:key="month">
        <text class="month-label">{{item.month}}</text>
        <view class="progress-track"><view class="progress-fill income-fill" style="width: {{item.ratio}}%"></view></view>
        <text class="progress-money">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">收入分类占比</view>
      <view class="progress-item" wx:for="{{income.incomeCategories}}" wx:key="name">
        <view class="progress-head"><text>{{item.name}}</text><text>¥{{item.amount}}</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{item.ratio}}%; background: {{item.color}}"></view></view>
        <view class="progress-foot">{{item.ratio}}%</view>
      </view>
      <view wx:if="{{income.hasMoreIncomeCategory}}" class="expand-btn" bindtap="toggleIncomeCategory">{{showAllIncomeCategory ? '收起' : '展开全部'}}</view>
      <view wx:if="{{!income.incomeCategories.length}}" class="empty">暂无分类数据</view>
    </view>

    <view class="section-card">
      <view class="section-title">收入 Top10</view>
      <view class="rank-item" wx:for="{{income.topIncomeList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="rank-index">{{index + 1}}</view>
        <view class="rank-main">
          <view class="rank-title">{{item.category}}</view>
          <view class="rank-desc">{{item.description}}</view>
          <view class="rank-meta">{{item.date}}{{item.ownerText}}</view>
        </view>
        <view class="rank-amount income-amount">¥{{item.amount}}</view>
      </view>
      <view wx:if="{{!income.topIncomeList.length}}" class="empty">暂无收入记录</view>
    </view>

    <view class="section-card">
      <view class="section-title">收入洞察</view>
      <view class="insight-grid">
        <view class="insight-item"><text>收入最高的一天</text><text>¥{{income.insights.maxDayAmount}}</text><text>{{income.insights.maxDayDate}}</text></view>
        <view class="insight-item"><text>收入最高的月份</text><text>¥{{income.insights.maxMonthAmount}}</text><text>{{income.insights.maxMonthName}}</text></view>
        <view class="insight-item"><text>大额收入占比</text><text>{{income.insights.largeIncomeRatio}}%</text><text>&gt;¥10000</text></view>
        <view class="insight-item"><text>月均收入</text><text>¥{{income.insights.avgMonthAmount}}</text><text>12月平均</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-mask">加载中...</view>
</view>
