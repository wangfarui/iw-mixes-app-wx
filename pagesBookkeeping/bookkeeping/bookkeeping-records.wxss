.records-page {
  min-height: 100vh;
  background: #ffffff;
  color: #000000;
}

.sticky-filter {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  background: #ffffff;
}

.type-scroll {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  white-space: nowrap;
}

.type-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  margin-right: 18rpx;
  padding: 0 28rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  background: #ffffff;
  color: #111111;
  font-size: 30rpx;
  font-weight: 500;
}

.type-chip.active {
  border-color: #2f7cff;
  color: #2f7cff;
  font-weight: 600;
}

.filter-button {
  flex: 0 0 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: #2f7cff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.filter-button::after,
.panel-footer button::after {
  border: 0;
}

.summary-card {
  margin: 0;
  padding: 20rpx 20rpx 18rpx;
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
}

.date-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.date-row picker {
  min-width: 0;
}

.date-box {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #e1e1e1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #666666;
  font-size: 28rpx;
  line-height: 72rpx;
  white-space: nowrap;
  overflow: hidden;
}

.date-icon {
  position: relative;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border: 4rpx solid #c8cdd6;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.date-icon::before {
  content: '';
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 7rpx;
  height: 4rpx;
  background: #c8cdd6;
}

.date-icon::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 8rpx;
  height: 5rpx;
  border-left: 4rpx solid #c8cdd6;
  border-bottom: 4rpx solid #c8cdd6;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.date-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.date-separator {
  display: none;
}

.clear-date-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: #2f7cff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.statistics-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stat-item {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.stat-label {
  flex: none;
  color: #000000;
  font-size: 30rpx;
  line-height: 42rpx;
}

.stat-value {
  display: block;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  white-space: nowrap;
}

.stat-value.consume {
  color: #ff6b35;
}

.stat-value.income {
  color: #07c160;
}

.record-list {
  margin: 0 20rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.record-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: 0;
}

.record-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
}

.record-source {
  flex: 1;
  min-width: 0;
  max-width: 100%;
  color: #222;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
  white-space: normal;
  word-break: break-all;
  word-wrap: break-word;
}

.record-amount {
  flex: none;
  max-width: 220rpx;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-amount.consume {
  color: #ff6b35;
}

.record-amount.income {
  color: #07c160;
}

.record-meta,
.record-time {
  margin-top: 6rpx;
  color: #999;
  font-size: 24rpx;
}

.load-more {
  padding: 32rpx 0 48rpx;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.filter-mask {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.35);
}

.filter-panel {
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.panel-title {
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
}

.panel-close {
  color: #999;
  font-size: 44rpx;
  line-height: 1;
}

.panel-body {
  max-height: 56vh;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
}

.filter-item {
  margin-bottom: 28rpx;
}

.filter-item.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.switch-row .filter-label {
  margin-bottom: 0;
}

.filter-input,
.picker-box {
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 26rpx;
  line-height: 72rpx;
}

.amount-row,
.sort-row {
  display: flex;
  align-items: center;
}

.amount-input {
  flex: 1;
}

.amount-line {
  margin: 0 16rpx;
  color: #999;
}

.sort-row picker {
  flex: 1;
}

.sort-row picker:first-child {
  margin-right: 16rpx;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 24rpx;
}

.tag-chip.selected {
  background: #e9f8ef;
  color: #07c160;
  font-weight: 600;
}

.panel-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.panel-footer button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 42rpx;
  font-size: 30rpx;
  line-height: 1;
  text-align: center;
}

.reset-button {
  background: #f0f1f3;
  color: #555;
}

.confirm-button {
  background: #07c160;
  color: #ffffff;
}
