.membership-page {
  min-height: 100vh;
  padding: 16rpx 16rpx 130rpx;
  background: #f6f7f9;
  box-sizing: border-box;
}

.toolbar {
  margin-bottom: 18rpx;
}

.modal-actions button::after {
  border: 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.search-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 20rpx;
  border: 4rpx solid #b6bdc8;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #b6bdc8;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #1f2329;
  font-size: 28rpx;
}

.search-placeholder {
  color: #b0b3b8;
  font-size: 28rpx;
}

.search-clear {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  color: #b0b3b8;
  font-size: 34rpx;
  line-height: 38rpx;
  text-align: center;
}

.filter-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 16rpx;
}

.filter-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66rpx;
  min-width: 0;
  padding: 0 18rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  background: #ffffff;
  color: #666;
  font-size: 25rpx;
  box-sizing: border-box;
}

.filter-select text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-arrow {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-left: 12rpx;
  margin-top: -8rpx;
  border-right: 4rpx solid #999;
  border-bottom: 4rpx solid #999;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.summary-card {
  min-width: 0;
  padding: 24rpx 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(31, 35, 41, 0.04);
  box-sizing: border-box;
}

.summary-title {
  color: #666;
  font-size: 25rpx;
  line-height: 34rpx;
}

.summary-value {
  margin-top: 12rpx;
  color: #111;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
  white-space: nowrap;
}

.subscription-list {
  background: #ffffff;
}

.subscription-item {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  padding: 22rpx 30rpx;
  border-top: 1rpx solid #eeeeee;
}

.subscription-item:first-child {
  border-top: 0;
}

.item-left {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.item-title,
.price-row,
.date-row,
.form-row,
.switch-line,
.modal-actions {
  display: flex;
  align-items: center;
}

.item-title {
  min-width: 0;
}

.membership-name {
  flex: none;
  max-width: 360rpx;
  color: #000000;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-tag {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #f3f3f3;
  color: #858585;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.price-row {
  margin-top: 8rpx;
  align-items: baseline;
}

.amount {
  color: #333333;
  font-size: 29rpx;
  line-height: 38rpx;
}

.cycle {
  margin-left: 8rpx;
  color: #999999;
  font-size: 25rpx;
  font-weight: 700;
}

.date-row {
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 8rpx;
  color: #888888;
  font-size: 24rpx;
  line-height: 34rpx;
}

.item-right {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 86rpx;
}

.status-tag {
  min-width: 60rpx;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
}

.status-tag.active {
  background: #eaf9ef;
  color: #20bf55;
}

.status-tag.warning {
  background: #fff7e6;
  color: #faad14;
}

.status-tag.expired {
  background: #fff1f0;
  color: #f56c6c;
}

.delete-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #fff0f0;
}

.delete-button::after,
.floating-add::after {
  border: 0;
}

.trash-icon {
  position: relative;
  width: 30rpx;
  height: 34rpx;
}

.trash-lid {
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #ef4444;
}

.trash-lid::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: -5rpx;
  width: 8rpx;
  height: 5rpx;
  border: 3rpx solid #ef4444;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.trash-body {
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 18rpx;
  height: 22rpx;
  border: 4rpx solid #ef4444;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.trash-body::before,
.trash-body::after {
  content: '';
  position: absolute;
  top: 4rpx;
  width: 3rpx;
  height: 13rpx;
  border-radius: 3rpx;
  background: #ef4444;
}

.trash-body::before {
  left: 3rpx;
}

.trash-body::after {
  right: 3rpx;
}

.floating-add {
  position: fixed;
  z-index: 40;
  right: 44rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #1677ff;
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 300;
  line-height: 96rpx;
  box-shadow: 0 10rpx 32rpx rgba(22, 119, 255, 0.3);
}

.empty {
  padding: 90rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.modal-mask,
.sheet-mask {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  background: rgba(0, 0, 0, 0.35);
}

.modal-mask {
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 90vw;
  max-height: 86vh;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.modal-title {
  margin-bottom: 22rpx;
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.form-scroll {
  max-height: 62vh;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item.half {
  flex: 1;
  min-width: 0;
}

.form-item.half:first-child {
  margin-right: 16rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #333;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker-box {
  height: 74rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 26rpx;
  line-height: 74rpx;
  box-sizing: border-box;
}

.switch-line {
  justify-content: space-between;
  margin: 4rpx 0 22rpx;
  color: #333;
  font-size: 26rpx;
}

.switch-line switch {
  transform: scale(0.76);
}

.modal-actions {
  gap: 18rpx;
  margin-top: 22rpx;
}

.modal-actions button {
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.cancel-btn {
  background: #f0f1f3;
  color: #555;
}

.confirm-btn {
  background: #07c160;
  color: #ffffff;
}

.sheet-mask {
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.sheet-item {
  height: 88rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.sheet-item.danger {
  color: #f56c6c;
}

.sheet-item.cancel {
  margin-bottom: 0;
  color: #999;
}
