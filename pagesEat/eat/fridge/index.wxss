@import "../eat-common.wxss";

.fridge-page {
  padding: 16rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.fridge-page .filter-card {
  padding: 14rpx 16rpx;
}

.fridge-page .filter-row {
  gap: 8rpx;
}

.fridge-page .filter-secondary {
  margin-top: 10rpx;
}

.fridge-page .filter-field {
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

.fridge-page .filter-name {
  flex: 2 1 0;
}

.fridge-page .filter-sort {
  flex: 1 1 0;
}

.fridge-page .filter-toggle {
  position: relative;
  flex: 0 0 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #eef5ff;
  color: #007aff;
  box-sizing: border-box;
}

.fridge-page .filter-toggle.active::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff6b35;
}

.fridge-page .filter-toggle-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: translateY(-4rpx) rotate(45deg);
  box-sizing: border-box;
}

.fridge-page .filter-toggle.expanded .filter-toggle-icon {
  transform: translateY(4rpx) rotate(225deg);
}

.fridge-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #007aff;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.3);
}

.fridge-fab:active {
  transform: scale(0.94);
  box-shadow: 0 3rpx 12rpx rgba(0, 122, 255, 0.22);
}

.fridge-fab-plus {
  display: block;
  height: 88rpx;
  color: inherit;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 82rpx;
}
