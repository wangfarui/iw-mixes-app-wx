@import "../eat-common.wxss";

.order-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.order-filter-card {
  padding: 16rpx;
}

.order-search-row {
  gap: 12rpx;
}

.order-search-field {
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 31rpx;
  font-size: 24rpx;
  line-height: 62rpx;
}

.order-search-btn,
.order-clear-btn {
  flex: none;
  height: 62rpx;
  min-width: 88rpx;
  padding: 0 20rpx;
  border-radius: 31rpx;
  font-size: 24rpx;
  line-height: 62rpx;
}

.order-search-btn {
  flex: 0 0 96rpx;
  width: 96rpx;
  min-width: 96rpx;
  padding: 0;
  background: #007aff;
  color: #ffffff;
  white-space: nowrap;
}

.order-category-row {
  display: block;
  margin-bottom: 22rpx;
  padding: 0;
}

.order-category-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 20rpx;
  white-space: nowrap;
}

.order-category-chip {
  flex: none;
}

.order-dish-card {
  position: relative;
  align-items: stretch;
  min-height: 156rpx;
}

.order-dish-card.selected {
  outline: 2rpx solid #b9dcff;
}

.order-dish-main {
  display: flex;
  flex-direction: column;
}

.order-dish-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
}

.order-tag-row {
  flex: 1;
  min-width: 0;
}

.order-cart-action {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #007aff;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

.order-cart-action.selected {
  background: #eef5ff;
  color: #007aff;
  outline: 2rpx solid #d6e9ff;
}

.order-cart-action.disabled {
  background: #e6e6e6;
  color: #999999;
}

.image-placeholder {
  text-align: center;
}

.image-placeholder-error {
  color: #dd524d;
  background: #fff4f4;
}

.order-cart-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-radius: 48rpx;
  background: rgba(34, 34, 34, 0.94);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  overflow: hidden;
}

.order-cart-summary {
  flex: 1;
  min-width: 0;
  padding: 14rpx 24rpx;
}

.order-cart-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.order-cart-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #dd524d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.order-cart-meta {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.order-cart-submit {
  flex: none;
  width: 170rpx;
  height: 96rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.order-cart-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.38);
}

.order-cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  max-height: 78vh;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.order-cart-header,
.order-cart-footer,
.order-cart-item {
  display: flex;
  align-items: center;
}

.order-cart-header {
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.order-cart-heading {
  color: #222222;
  font-size: 32rpx;
  font-weight: 700;
}

.order-cart-count {
  margin-top: 4rpx;
  color: #777777;
  font-size: 24rpx;
}

.order-cart-clear {
  flex: none;
  color: #dd524d;
  font-size: 26rpx;
}

.order-cart-list {
  height: 52vh;
}

.order-cart-item {
  gap: 16rpx;
  min-height: 126rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-cart-item:last-child {
  border-bottom: 0;
}

.order-cart-image {
  flex: none;
  width: 112rpx;
  height: 92rpx;
  border-radius: 10rpx;
  background: #f0f1f3;
}

.order-cart-item-main {
  flex: 1;
  min-width: 0;
}

.order-cart-remove {
  flex: none;
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 25rpx;
  background: #ffeeee;
  color: #dd524d;
  font-size: 23rpx;
  line-height: 50rpx;
}

.order-cart-footer {
  gap: 18rpx;
  margin-top: 22rpx;
}

.order-cart-cancel,
.order-cart-order {
  flex: 1;
}
