<view class="eat-page dish-detail-page {{isOrderMode ? 'order-mode' : ''}}">
  <image wx:if="{{detail.dishesImage}}" class="cover-image detail-cover-image" src="{{detail.dishesImage}}" mode="aspectFill" bindtap="previewImage" />
  <view wx:else class="cover-image detail-cover-image image-placeholder">暂无图片</view>

  <view class="section-card">
    <view class="item-row">
      <view class="item-title">{{detail.dishesName || '-'}}</view>
      <view class="item-value">¥{{detail.prices || 0}}</view>
    </view>
    <view class="item-meta">{{detail.dishesTypeName}} · {{detail.useTime || 0}}分钟 · 难度{{detail.difficultyFactor || 0}}</view>
    <view wx:if="{{detail.remark}}" class="item-meta">备注：{{detail.remark}}</view>
    <view class="tag-row">
      <view wx:if="{{isOwner}}" class="tag owner">本人创建</view>
      <view class="tag {{canOrder ? '' : 'danger'}}">{{detail.statusName}}</view>
    </view>
    <view wx:if="{{!isOrderMode}}" class="button-row">
      <button class="plain-btn" bindtap="addToCart">加入餐食</button>
      <button wx:if="{{isOwner}}" class="primary-btn" bindtap="goEdit">编辑</button>
      <button wx:if="{{isOwner}}" class="danger-btn" bindtap="confirmDelete">删除</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">食材列表</view>
    <view class="mini-card" wx:for="{{detail.dishesMaterialList}}" wx:key="index">
      <view class="item-row">
        <view class="item-title">{{item.materialName}}</view>
        <view class="item-value">¥{{item.materialPrice || 0}}</view>
      </view>
      <view class="item-meta">用量：{{item.materialDosage || '-'}}</view>
      <view wx:if="{{item.isPurchase}}" class="tag warn">需要购买</view>
    </view>
    <view wx:if="{{!detail.dishesMaterialList.length}}" class="empty">暂无食材</view>
  </view>

  <view class="section-card">
    <view class="section-title">制作步骤</view>
    <view class="mini-card" wx:for="{{detail.dishesCreationMethodList}}" wx:key="index">
      <view class="item-meta">步骤 {{index + 1}}</view>
      <image wx:if="{{item.stepImage}}" class="dish-image" src="{{item.stepImage}}" mode="aspectFill" bindtap="previewStepImage" data-url="{{item.stepImage}}" />
      <view class="item-meta">{{item.stepContent || '-'}}</view>
    </view>
    <view wx:if="{{!detail.dishesCreationMethodList.length}}" class="empty">暂无步骤</view>
  </view>

  <view wx:if="{{isOrderMode}}" class="detail-order-bar">
    <view class="detail-order-summary">
      <view class="detail-order-price">¥{{detail.priceText || '0'}}</view>
      <view class="detail-order-meta">{{detail.useTime || 0}}分钟 · 已选 {{cartSummary.count}} 道</view>
    </view>
    <view wx:if="{{cartSummary.count > 0}}" class="plain-btn detail-cart-btn" bindtap="goCartConfirm">去下单</view>
    <view class="primary-btn detail-add-btn {{inCart ? 'selected' : ''}} {{!canOrder && !inCart ? 'disabled' : ''}}" bindtap="toggleCart">{{inCart ? '移出购物车' : '加入购物车'}}</view>
  </view>
</view>
