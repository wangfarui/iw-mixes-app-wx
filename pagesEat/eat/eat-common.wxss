.eat-page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.filter-card,
.section-card,
.form-card,
.dish-card,
.food-card,
.meal-card {
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-card,
.section-card,
.form-card {
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.filter-row,
.button-row,
.item-row,
.category-row,
.form-line {
  display: flex;
  align-items: center;
}

.filter-row {
  gap: 12rpx;
}

.filter-field,
.form-input,
.picker-field {
  height: 66rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 26rpx;
  line-height: 66rpx;
  box-sizing: border-box;
}

.filter-field {
  flex: 1;
  min-width: 0;
}

.category-row {
  gap: 14rpx;
  margin: 0 -20rpx 20rpx;
  padding: 0 20rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  background: #ffffff;
  color: #666;
  font-size: 25rpx;
}

.category-chip.active {
  background: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.dish-card,
.food-card,
.meal-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
}

.dish-image,
.cover-image {
  flex: none;
  width: 150rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f0f1f3;
}

.cover-image {
  width: 220rpx;
  height: 160rpx;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-row {
  justify-content: space-between;
  gap: 16rpx;
}

.item-title {
  flex: 1;
  min-width: 0;
  color: #222;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-value {
  flex: none;
  color: #ff6b35;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.item-meta {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  background: #f2f7ff;
  color: #007aff;
  font-size: 22rpx;
  line-height: 42rpx;
}

.tag.warn {
  background: #fff3e8;
  color: #ff6b35;
}

.tag.owner {
  background: #e8f7ee;
  color: #07c160;
}

.tag.danger {
  background: #ffeeee;
  color: #dd524d;
}

.primary-btn,
.plain-btn,
.danger-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  line-height: 68rpx;
}

.primary-btn::after,
.plain-btn::after,
.danger-btn::after,
.fab::after {
  border: 0;
}

.primary-btn {
  background: #007aff;
  color: #ffffff;
}

.plain-btn {
  background: #eef5ff;
  color: #007aff;
}

.danger-btn {
  background: #faecd8;
  color: #e6a23c;
}

.button-row {
  gap: 18rpx;
  margin-top: 22rpx;
}

.button-row button {
  flex: 1;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 48rpx;
  z-index: 20;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #007aff;
  color: #ffffff;
  font-size: 54rpx;
  line-height: 94rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 122, 255, 0.32);
}

.cart-bar {
  position: fixed;
  left: 20rpx;
  right: 150rpx;
  bottom: 48rpx;
  z-index: 19;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 44rpx;
  background: rgba(34, 34, 34, 0.9);
  color: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-line {
  gap: 20rpx;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-line:last-child {
  border-bottom: 0;
}

.form-label {
  flex: none;
  width: 170rpx;
  color: #555;
  font-size: 26rpx;
}

.form-input,
.picker-field {
  flex: 1;
  min-width: 0;
  background: transparent;
}

.form-textarea {
  flex: 1;
  min-height: 130rpx;
  padding: 18rpx 0;
  color: #222;
  font-size: 27rpx;
  box-sizing: border-box;
}

.sub-section {
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #222;
  font-size: 30rpx;
  font-weight: 700;
}

.mini-card {
  margin-bottom: 14rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
}

.mini-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.mini-actions button {
  flex: 1;
  height: 54rpx;
  border-radius: 27rpx;
  font-size: 23rpx;
  line-height: 54rpx;
}

.empty,
.load-more {
  padding: 36rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.food-emoji {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f2f7ff;
  font-size: 38rpx;
  line-height: 72rpx;
  text-align: center;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.emoji-item {
  height: 72rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 36rpx;
  line-height: 72rpx;
  text-align: center;
}

.emoji-item.active {
  background: #e8f2ff;
  outline: 2rpx solid #007aff;
}
