.login-page {
  min-height: 100vh;
  padding: 0 40rpx;
  background: #f5f7fb;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.login-panel {
  width: 100%;
  margin-top: 9vh;
}

.brand-logo {
  display: block;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
}

.brand {
  color: #111827;
  font-size: 52rpx;
  font-weight: 700;
  text-align: center;
}

.brand-subtitle {
  margin-top: 12rpx;
  margin-bottom: 56rpx;
  color: #6b7280;
  font-size: 28rpx;
  text-align: center;
}

.login-form {
  border-radius: 24rpx;
  overflow: visible;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.08);
}

.weui-cell {
  min-height: 104rpx;
}

.weui-input {
  height: 56rpx;
  color: #111827;
  font-size: 32rpx;
}

.account-field {
  position: relative;
  z-index: 10;
}

.account-cell {
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
}

.account-cell.is-open {
  background: #fbfcfe;
}

.account-cell .weui-cell__bd {
  flex: 1;
  min-width: 0;
}

.account-history-toggle {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-right: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.account-history-toggle-active {
  opacity: 0.55;
}

.history-chevron {
  width: 14rpx;
  height: 14rpx;
  margin-top: -8rpx;
  border-right: 2rpx solid #98a2b3;
  border-bottom: 2rpx solid #98a2b3;
  transform: rotate(45deg);
  transition: transform 160ms ease, margin-top 160ms ease;
}

.history-chevron.is-open {
  margin-top: 8rpx;
  transform: rotate(225deg);
}

.history-dropdown {
  position: absolute;
  z-index: 20;
  top: calc(100% + 8rpx);
  right: 0;
  left: 0;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.16);
}

.history-list {
  width: 100%;
}

.history-item {
  position: relative;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 12rpx 0 32rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
}

.history-item::after {
  position: absolute;
  right: 20rpx;
  bottom: 0;
  left: 32rpx;
  height: 1rpx;
  background: #f0f2f5;
  content: '';
}

.history-item:last-child::after {
  display: none;
}

.history-item.is-current {
  background: #f5f8ff;
}

.history-item-active {
  background: #f3f4f6;
}

.history-account {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #344054;
  font-size: 29rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-delete {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #98a2b3;
}

.history-delete .weui-icon-delete {
  width: 36rpx;
  height: 36rpx;
  color: inherit;
}

.history-delete-active {
  color: #d92d20;
}

.code-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-cell .weui-cell__bd {
  flex: 1;
  min-width: 0;
}

.code-cell .weui-cell__ft {
  flex: 0 0 176rpx;
  margin-left: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.code-btn {
  width: auto;
  min-width: 176rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #1677ff;
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 26rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.code-btn.is-disabled {
  color: #9ca3af;
  background: transparent;
}

.login-btn {
  margin-top: 48rpx;
  border-radius: 48rpx;
}

.login-options {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
  gap: 24rpx;
  color: #1677ff;
  font-size: 28rpx;
}

.option-divider {
  color: #d1d5db;
}

.custom-loading {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.68);
}

.loading-content {
  width: 640rpx;
  padding: 48rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.loading-text {
  margin-bottom: 32rpx;
  color: #111827;
  font-size: 30rpx;
  text-align: center;
}

.progress-bar {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf2f7;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #1677ff;
  transition: width 50ms linear;
}

.progress-text {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 26rpx;
  text-align: center;
}

.invite-modal-mask {
  position: fixed;
  z-index: 120;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.45);
}

.invite-modal-card {
  width: 100%;
  max-width: 640rpx;
  box-sizing: border-box;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.invite-modal-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.invite-modal-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.invite-modal-close {
  padding: 0 12rpx;
  color: #9ca3af;
  font-size: 40rpx;
}

.invite-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  color: #111827;
  font-size: 32rpx;
  letter-spacing: 0;
}

.invite-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}

.invite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

.invite-btn.secondary {
  background: #f3f4f6;
  color: #4b5563;
}

.invite-btn.primary {
  background: #1677ff;
  color: #ffffff;
}

.invite-btn.disabled {
  opacity: 0.7;
}
