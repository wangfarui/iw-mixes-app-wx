<view class="login-page" bindtap="closeHistoryDropdown">
  <view class="login-panel">
    <image class="brand-logo" src="/static/logo.png" mode="aspectFit" />
    <view class="brand">瑞菁日常</view>
    <view class="brand-subtitle">欢迎回来</view>

    <view class="weui-cells weui-cells_form login-form">
      <view class="account-field">
        <view class="weui-cell account-cell {{isHistoryOpen ? 'is-open' : ''}}">
          <view class="weui-cell__bd">
            <input
              class="weui-input"
              value="{{form.account}}"
              maxlength="{{accountMaxLength}}"
              placeholder="{{accountPlaceholder}}"
              bindinput="onAccountInput"
            />
          </view>
          <view
            wx:if="{{historyRecords.length}}"
            class="account-history-toggle"
            hover-class="account-history-toggle-active"
            catchtap="toggleHistoryDropdown"
            aria-role="button"
            aria-label="{{isHistoryOpen ? '收起已保存账号' : '展开已保存账号'}}"
          >
            <view class="history-chevron {{isHistoryOpen ? 'is-open' : ''}}"></view>
          </view>
        </view>

        <view wx:if="{{isHistoryOpen && historyRecords.length}}" class="history-dropdown" catchtap="preventTap">
          <scroll-view class="history-list" style="height: {{historyListHeight}}rpx;" scroll-y enhanced show-scrollbar="{{false}}">
            <view
              wx:for="{{historyRecords}}"
              wx:key="account"
              class="history-item {{form.account === item.account ? 'is-current' : ''}}"
              data-index="{{index}}"
              hover-class="history-item-active"
              catchtap="selectHistory"
              aria-role="button"
              aria-label="选择账号 {{item.account}}"
            >
              <text class="history-account">{{item.account}}</text>
              <view
                class="history-delete"
                data-index="{{index}}"
                hover-class="history-delete-active"
                catchtap="deleteHistory"
                aria-role="button"
                aria-label="删除账号 {{item.account}}"
              >
                <view class="weui-icon-delete"></view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="weui-cell" wx:if="{{loginWay === '3'}}">
        <view class="weui-cell__bd">
          <input
            class="weui-input"
            value="{{form.password}}"
            password
            placeholder="请输入密码"
            bindinput="onPasswordInput"
          />
        </view>
      </view>

      <view class="weui-cell code-cell" wx:if="{{loginWay !== '3'}}">
        <view class="weui-cell__bd">
          <input
            class="weui-input"
            value="{{form.verificationCode}}"
            maxlength="6"
            placeholder="请输入验证码"
            bindinput="onVerificationCodeInput"
          />
        </view>
        <view class="weui-cell__ft">
          <view
            class="code-btn {{isCountingDown || isGettingCode ? 'is-disabled' : ''}}"
            bindtap="getVerificationCode"
          >
            {{verificationButtonText}}
          </view>
        </view>
      </view>
    </view>

    <button class="weui-btn weui-btn_primary login-btn" loading="{{isSubmitting}}" bindtap="handleLogin">登录</button>

    <view class="login-options">
      <text wx:if="{{loginWay !== '3'}}" bindtap="switchToPassword">账号登录</text>
      <text wx:if="{{loginWay === '3'}}" bindtap="switchToPhone">手机号登录</text>
      <text class="option-divider">|</text>
      <text wx:if="{{loginWay !== '2'}}" bindtap="switchToEmail">邮箱登录</text>
      <text wx:if="{{loginWay === '2'}}" bindtap="switchToPhone">手机号登录</text>
    </view>
  </view>

  <view class="custom-loading" wx:if="{{showFirstLoginLoading}}">
    <view class="loading-content">
      <view class="loading-text">首次登录，正在加载资源...</view>
      <view class="progress-bar">
        <view class="progress-inner" style="width: {{loadingProgress}}%;"></view>
      </view>
      <view class="progress-text">{{loadingProgress}}%</view>
    </view>
  </view>

  <view wx:if="{{showInviteDialog}}" class="invite-modal-mask">
    <view class="invite-modal-card">
      <view class="invite-modal-title-row">
        <text class="invite-modal-title">新用户注册</text>
        <text class="invite-modal-close" bindtap="closeInviteDialog">×</text>
      </view>
      <input
        class="invite-input"
        value="{{inviteCode}}"
        maxlength="6"
        placeholder="请输入邀请码"
        bindinput="onInviteCodeInput"
      />
      <view class="invite-actions">
        <view class="invite-btn secondary" bindtap="closeInviteDialog">取消</view>
        <view class="invite-btn primary {{isSubmittingInvite ? 'disabled' : ''}}" bindtap="submitInviteCode">
          {{isSubmittingInvite ? '注册中...' : '完成注册'}}
        </view>
      </view>
    </view>
  </view>
</view>
