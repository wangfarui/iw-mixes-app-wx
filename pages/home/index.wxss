.home-container {
  min-height: 100vh;
  padding: 20rpx;
  background: #f5f6fa;
}

.weather-card {
  margin-bottom: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3578e5, #20b486);
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.weather-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.temperature {
  margin-right: 20rpx;
  font-size: 60rpx;
  font-weight: 700;
}

.weather-error {
  font-size: 36rpx;
}

.weather-desc {
  font-size: 32rpx;
}

.weather-detail {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  opacity: 0.9;
}

.cards-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.function-card {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header,
.card-left,
.bill-title-row,
.detail-item {
  display: flex;
  align-items: center;
}

.card-header {
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
}

.card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #eef6ff;
}

.card-icon-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-title {
  margin-bottom: 10rpx;
  color: #666;
  font-size: 28rpx;
}

.card-value {
  display: block;
  color: #333;
  font-size: 36rpx;
  font-weight: 700;
  word-break: break-all;
}

.quick-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #eef6ff;
  color: #1677ff;
  font-size: 24rpx;
  white-space: nowrap;
}

.card-details {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-item {
  padding: 10rpx 0;
  font-size: 26rpx;
}

.more-link {
  margin-top: 10rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #f0f0f0;
  color: #1677ff;
  font-size: 26rpx;
  text-align: center;
}

.empty-line {
  padding: 10rpx 0;
  color: #a0a4aa;
  font-size: 26rpx;
}

.scope-badge {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #1677ff;
  font-size: 20rpx;
  line-height: 1.4;
}

.bill-time,
.points-time {
  flex: 1;
  margin-right: 10rpx;
  color: #999;
}

.bill-source,
.points-source,
.detail-title {
  flex: 2;
  min-width: 0;
  margin-right: 10rpx;
  color: #333;
}

.bill-amount,
.points-value,
.detail-deadline {
  flex: 1;
  font-weight: 700;
  text-align: right;
}

.bill-amount,
.points-value {
  color: #ff4d4f;
}

.bill-list .detail-item {
  align-items: flex-start;
}

.bill-list .bill-time {
  flex: none;
  width: 72rpx;
  line-height: 36rpx;
}

.bill-list .bill-source {
  flex: 1;
  min-width: 0;
  max-width: 100%;
  line-height: 36rpx;
  white-space: normal;
  word-break: break-all;
  word-wrap: break-word;
}

.bill-list .bill-amount {
  flex: none;
  min-width: 112rpx;
  margin-left: 10rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.points-value.add {
  color: #16a34a;
}

.deadline-red {
  color: #ff4d4f;
}

.deadline-yellow {
  color: #faad14;
}

.deadline-black {
  color: #333;
}

.recipe-section {
  padding: 30rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: #333;
  font-size: 32rpx;
  font-weight: 700;
}

.more-link-text {
  color: #1677ff;
  font-size: 26rpx;
}

.recipe-scroll {
  width: 100%;
  height: 280rpx;
  white-space: nowrap;
}

.recipe-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 240rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.recipe-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.recipe-name {
  max-width: 240rpx;
  overflow: hidden;
  color: #333;
  font-size: 26rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-recipe {
  padding-top: 80rpx;
  color: #a0a4aa;
  font-size: 26rpx;
}
