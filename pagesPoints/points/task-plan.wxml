<view class="points-page task-plan-page">
  <view class="filter-card task-plan-filter">
    <view class="filter-row task-plan-filter-row">
      <input class="filter-field task-plan-search" value="{{searchForm.taskName}}" placeholder="任务名称" data-field="taskName" bindinput="handleSearchInput" confirm-type="search" bindconfirm="search" />
      <picker class="filter-field task-plan-status-picker" mode="selector" range="{{statusOptions}}" range-key="text" value="{{statusIndex}}" bindchange="onStatusChange">
        <view>{{statusName || '全部状态'}}</view>
      </picker>
      <button class="plain-btn task-plan-search-btn" bindtap="search">搜索</button>
    </view>
  </view>

  <view class="list-card">
    <view class="list-item task-plan-item" wx:for="{{list}}" wx:key="id" bindlongpress="openActions" data-index="{{index}}">
      <view class="item-row task-plan-header">
        <view class="item-title task-plan-title">{{item.taskNameText}}</view>
        <view class="status-tag task-plan-status-tag {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="task-plan-date-grid">
        <view class="task-plan-date-cell">
          <view class="task-plan-date-label">计划日期</view>
          <view class="task-plan-date-value">{{item.planDateText}}</view>
        </view>
        <view class="task-plan-date-cell">
          <view class="task-plan-date-label">下次生成</view>
          <view class="task-plan-date-value">{{item.nextPlanDateText}}</view>
        </view>
      </view>
      <view wx:if="{{item.createTimeText}}" class="item-meta task-plan-created">创建时间：{{item.createTimeText}}</view>
    </view>
    <view wx:if="{{!list.length && !loading}}" class="empty">暂无任务计划</view>
    <view class="load-more">{{loadMoreText}}</view>
  </view>

  <view class="fab task-plan-fab" bindtap="navigateToAdd">+</view>

  <view wx:if="{{generationConfirmVisible}}" class="generation-mask" catchtap="cancelGenerationConfirm">
    <view class="generation-dialog" catchtap="stopGenerationTap">
      <view class="generation-title">{{generationPreview.retry ? '重试立即生成' : '立即生成待办'}}</view>
      <scroll-view class="generation-body" scroll-y>
        <view class="generation-name">{{generationPreview.taskName}}</view>
        <view class="generation-row"><text class="generation-label">本次计划日期</text><text>{{generationPreview.retry ? '以生成结果为准' : generationPreview.planDate}}</text></view>
        <view class="generation-row"><text class="generation-label">截止日期</text><text>{{generationPreview.retry ? '以生成结果为准' : generationPreview.deadlineDate}}</text></view>
        <view class="generation-row"><text class="generation-label">奖励积分</text><text>{{generationPreview.rewardPoints}} 分</text></view>
        <view class="generation-row"><text class="generation-label">处罚积分</text><text>{{generationPreview.punishPoints}} 分</text></view>
        <view class="generation-bookkeeping"><view class="generation-label">完成时自动记账</view><view>{{generationPreview.bookkeepingText}}</view></view>
        <view class="generation-hint">{{generationPreview.retry ? '以上为当前计划配置。上次结果未确认，若已生成将返回原任务并保留原参数，不会重复创建。' : '额外生成一条待办，原计划日期和下次生成日期不变。'}}</view>
      </scroll-view>
      <view class="generation-actions">
        <view class="generation-action" catchtap="cancelGenerationConfirm">取消</view>
        <view class="generation-action generation-confirm" catchtap="confirmGeneration">{{generationPreview.retry ? '重试' : '生成'}}</view>
      </view>
    </view>
  </view>
</view>
