<view class="points-page">
  <view class="form-card">
    <view class="form-row">
      <view class="form-label">任务名称</view>
      <input class="form-input" value="{{formData.taskName}}" placeholder="请输入任务名称" data-field="taskName" bindinput="handleInput" />
    </view>
    <view class="form-row">
      <view class="form-label">任务备注</view>
      <textarea class="form-textarea" value="{{formData.taskRemark}}" placeholder="请输入任务备注" data-field="taskRemark" bindinput="handleInput" auto-height />
    </view>
    <view class="form-row">
      <view class="form-label">计划周期</view>
      <picker class="filter-field" mode="selector" range="{{planCycleOptions}}" range-key="text" value="{{planCycleIndex}}" bindchange="onPlanCycleChange">
        <view>{{planCycleName}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">计划日期</view>
      <picker class="filter-field" mode="date" value="{{formData.planDate}}" bindchange="onPlanDateChange">
        <view>{{formData.planDate || '请选择计划日期'}}</view>
      </picker>
    </view>
    <view wx:if="{{formData.planCycle === 5}}" class="form-row">
      <view class="form-label">计划天数</view>
      <input class="form-input" type="number" value="{{formData.cycleDays}}" placeholder="请输入计划天数" data-field="cycleDays" bindinput="handleInput" />
    </view>
    <view class="form-row">
      <view class="form-label">提前提醒天数</view>
      <input class="form-input" type="number" value="{{formData.remindDays}}" placeholder="请输入提前提醒天数" data-field="remindDays" bindinput="handleInput" />
    </view>
    <view class="form-row">
      <view class="form-label">截止天数</view>
      <input class="form-input" type="number" value="{{formData.deadlineDays}}" placeholder="请输入截止天数" data-field="deadlineDays" bindinput="handleInput" />
    </view>
    <view class="form-row">
      <view class="form-label">奖励积分</view>
      <input class="form-input" type="number" value="{{formData.rewardPoints}}" placeholder="请输入奖励积分" data-field="rewardPoints" bindinput="handleInput" />
    </view>
    <view class="form-row bookkeeping-switch">
      <view class="form-label">完成时自动记账</view>
      <switch checked="{{formData.bookkeepingEnabled}}" bindchange="onBookkeepingChange" color="#07c160" />
    </view>
    <view wx:if="{{formData.bookkeepingEnabled}}" class="form-row">
      <view wx:if="{{templateSummary}}" class="template-summary">{{templateSummary}}</view>
      <view wx:if="{{formData.bookkeepingTemplate}}" class="template-hint">分类：{{templateTypeName}}　日期：完成当天</view>
      <view class="template-link" bindtap="editBookkeepingTemplate">{{formData.bookkeepingTemplate ? '编辑记账模板' : '设置记账模板'}}</view>
      <view class="template-hint">修改记账模板仅影响以后生成的任务，已生成任务保持原配置。</view>
    </view>
    <view class="form-row">
      <view class="form-label">处罚积分</view>
      <input class="form-input" type="number" value="{{formData.punishPoints}}" placeholder="请输入处罚积分" data-field="punishPoints" bindinput="handleInput" />
    </view>
  </view>

  <view class="button-row">
    <button class="primary-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSubmit">保存</button>
    <button class="plain-btn" bindtap="handleCancel">取消</button>
  </view>
</view>
