<view class="base-page">
  <view class="summary-card">
    <view class="summary-item">
      <view class="summary-value">{{totalCount}}</view>
      <view class="summary-label">{{filterActive ? '筛选结果' : '全部匹配'}}</view>
    </view>
    <view class="summary-item">
      <view class="summary-value enabled">{{activeCount}}</view>
      <view class="summary-label">已加载启用</view>
    </view>
    <view class="summary-item">
      <view class="summary-value muted">{{disabledCount}}</view>
      <view class="summary-label">已加载禁用</view>
    </view>
  </view>

  <view class="filter-card">
    <view class="filter-row">
      <picker class="filter-field" mode="selector" range="{{dictTypeOptions}}" range-key="text" value="{{dictTypeIndex}}" bindchange="onDictTypeChange">
        <view class="{{dictTypeName ? '' : 'field-placeholder'}}">{{dictTypeName || '全部类型'}}</view>
      </picker>
      <picker class="filter-field" mode="selector" range="{{statusOptions}}" range-key="text" value="{{statusIndex}}" bindchange="onStatusChange">
        <view class="{{statusName ? '' : 'field-placeholder'}}">{{statusName || '全部状态'}}</view>
      </picker>
    </view>
    <view class="filter-row">
      <input class="filter-field filter-input" value="{{filterForm.dictName}}" placeholder="请输入字典名称" bindinput="onNameInput" confirm-type="search" bindconfirm="applyFilter" />
    </view>
    <view class="filter-row action-row">
      <button class="primary-btn" bindtap="goAdd">新增</button>
      <button class="plain-btn" bindtap="resetFilter">重置</button>
      <button class="plain-btn" bindtap="applyFilter">搜索</button>
    </view>
  </view>

  <view class="list-card">
    <view class="list-item dict-item" wx:for="{{dictList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="item-main">
        <view class="item-top">
          <view class="item-title">{{item.dictName}}</view>
          <view class="status-pill {{item.dictStatus === 1 ? '' : 'disabled'}}">{{item.dictStatusName}}</view>
        </view>
        <view class="item-meta strong">{{item.dictTypeName}}</view>
        <view class="meta-grid">
          <view class="meta-cell">编码：{{item.dictCodeText}}</view>
          <view class="meta-cell">排序：{{item.sortText}}</view>
          <view class="meta-cell">父级：{{item.parentText}}</view>
        </view>
      </view>
      <view class="item-actions">
        <view class="mini-action edit" catchtap="editDict" data-id="{{item.id}}">编辑</view>
        <view class="mini-action danger" catchtap="confirmDelete" data-id="{{item.id}}" data-name="{{item.dictName}}">删除</view>
      </view>
    </view>
    <view wx:if="{{!dictList.length && !loading}}" class="empty empty-panel">
      <view class="empty-title">暂无字典数据</view>
      <button class="primary-btn empty-action" bindtap="goAdd">新增字典项</button>
    </view>
    <view class="load-more">{{loadMoreText}}</view>
  </view>
</view>
