@import "./base-common.wxss";

.base-page {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.summary-card {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}

.summary-value {
  color: #222;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.1;
}

.summary-value.enabled {
  color: #07c160;
}

.summary-value.muted {
  color: #909399;
}

.summary-label {
  margin-top: 8rpx;
  color: #777;
  font-size: 22rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.field-placeholder {
  color: #909399;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.action-row button {
  width: 100%;
  min-width: 0;
  padding: 0;
}

.dict-item {
  align-items: flex-start;
}

.item-top {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.item-top .item-title {
  flex: 1;
}

.item-top .status-pill {
  flex: none;
  margin-top: 0;
}

.item-meta.strong {
  color: #4f5f73;
  font-weight: 600;
}

.dict-item .item-main {
  flex: 1 1 80%;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  margin-top: 12rpx;
}

.meta-cell {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 22rpx;
  line-height: 1.35;
  box-sizing: border-box;
  word-break: break-all;
}

.item-actions {
  flex: 0 0 20%;
  width: 20%;
  min-width: 112rpx;
  max-width: 140rpx;
  align-self: stretch;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 52rpx;
  padding: 0;
  border-radius: 8rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 52rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.mini-action.edit {
  background: #eef5ff;
  color: #007aff;
}

.mini-action.danger {
  background: #fff2f0;
  color: #dd524d;
}

.mini-action:active {
  opacity: 0.72;
}

.empty-panel {
  padding: 70rpx 24rpx;
}

.empty-title {
  margin-bottom: 22rpx;
  color: #888;
  font-size: 26rpx;
}

.empty-action {
  width: 220rpx;
  margin: 0 auto;
}
