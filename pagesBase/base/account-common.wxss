page { background: #f5f6f7; color: #222; }
button { margin:0; padding:0; border:0; background:none; font-size:inherit; line-height:inherit; border-radius:0; }
button::after { border:0; }
button[disabled] { opacity:.4; color:inherit; background:none; }
.account-page { padding:24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.group { background:#fff; border-radius:24rpx; overflow:hidden; }
.muted { color:#8a948d; font-size:24rpx; line-height:36rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:32rpx 4rpx 20rpx; color:#89938d; font-size:26rpx; }
.link { color:#078453; font-size:26rpx; white-space:nowrap; padding:12rpx 4rpx; }
.primary { height:96rpx; display:flex; align-items:center; justify-content:center; background:#07a665; color:#fff; font-size:30rpx; font-weight:500; border-radius:18rpx; }
.primary[disabled] { background:#07a665; color:#fff; }
.footer { position:fixed; bottom:0; left:0; right:0; padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid #e9eeeb; z-index:10; }
.empty { text-align:center; color:#929c95; font-size:28rpx; padding:96rpx 24rpx; }
.error { color:#bd4f47; font-size:24rpx; line-height:36rpx; margin:16rpx 4rpx; }
.retry { text-align:center; padding:24rpx; color:#087e50; font-size:26rpx; }
.mask { position:fixed; inset:0; background:rgba(20,35,27,.4); z-index:30; display:flex; align-items:flex-end; }
.sheet { width:100%; background:#fff; border-radius:36rpx 36rpx 0 0; padding:24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing:border-box; max-height:82vh; overflow-y:auto; }
.sheet-handle { width:72rpx; height:8rpx; border-radius:8rpx; background:#dce0dd; margin:0 auto 32rpx; }
.sheet-title { display:flex; justify-content:space-between; align-items:center; gap:24rpx; font-size:36rpx; font-weight:500; margin-bottom:32rpx; word-break:break-all; }
.close { flex:0 0 64rpx; min-height:64rpx; display:flex; align-items:center; justify-content:center; font-size:42rpx; font-weight:400; }
.sheet-label { font-size:26rpx; margin-bottom:12rpx; }
.sheet-input { border:2rpx solid #dce3de; border-radius:16rpx; height:96rpx; min-height:96rpx; padding:0 24rpx; box-sizing:border-box; font-size:30rpx; width:100%; background:#fff; }
.sheet-note { color:#8d9690; font-size:24rpx; line-height:36rpx; margin-top:20rpx; }
.sheet-buttons { display:flex; gap:24rpx; margin-top:40rpx; }
.sheet-buttons .primary { flex:1; }
.secondary { min-width:180rpx; height:96rpx; border-radius:18rpx; display:flex; align-items:center; justify-content:center; background:#f0f2f1; font-size:30rpx; }
.sheet-row { display:flex; align-items:center; justify-content:space-between; gap:24rpx; min-height:100rpx; padding:16rpx 4rpx; border-bottom:1rpx solid #eff2f0; box-sizing:border-box; font-size:30rpx; word-break:break-all; }
.sheet-scroll { max-height:42vh; }
.danger { color:#c34d46; }
.footer .primary { width:100%; max-width:none; box-sizing:border-box; }
.sheet-buttons button.primary { width:auto; max-width:none; min-width:0; }
