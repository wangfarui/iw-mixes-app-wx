@import "./base-common.wxss";

.base-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.form-card {
  padding-top: 0;
}

.secondary-card {
  margin-top: 20rpx;
}

.section-title {
  height: 76rpx;
  color: #222;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 76rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label.required::after {
  content: "*";
  margin-left: 6rpx;
  color: #dd524d;
}

.field-placeholder {
  color: #909399;
}

.footer-actions {
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-actions button[disabled] {
  opacity: 0.72;
}
