.base-page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.filter-card,
.list-card,
.form-card,
.modal-card {
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-card {
  margin-bottom: 20rpx;
  padding: 18rpx;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-field {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 25rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.filter-input {
  line-height: normal;
}

.primary-btn,
.plain-btn,
.danger-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.primary-btn::after,
.plain-btn::after,
.danger-btn::after {
  border: 0;
}

.primary-btn {
  background: #007aff;
  color: #ffffff;
}

.plain-btn {
  background: #eef5ff;
  color: #007aff;
}

.danger-btn {
  background: #f3f4f6;
  color: #dd524d;
}

.list-card {
  overflow: hidden;
}

.list-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: 0;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  color: #222;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  display: inline-flex;
  height: 42rpx;
  margin-top: 10rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  background: #f0fff7;
  color: #07c160;
  font-size: 22rpx;
  line-height: 42rpx;
}

.status-pill.disabled {
  background: #f7f8fa;
  color: #999;
}

.item-actions {
  flex: none;
  display: flex;
  align-items: center;
}

.load-more,
.empty {
  padding: 36rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.form-card {
  padding: 10rpx 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-label {
  flex: none;
  width: 170rpx;
  color: #555;
  font-size: 27rpx;
}

.form-control {
  flex: 1;
  min-width: 0;
  color: #222;
  font-size: 27rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  color: #222;
  font-size: 27rpx;
}

.form-textarea {
  width: 100%;
  min-height: 138rpx;
  padding: 18rpx 0;
  color: #222;
  font-size: 27rpx;
  box-sizing: border-box;
}

.footer-actions {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0 0;
  background: #f5f5f5;
}

.footer-actions button {
  flex: 1;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.45);
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  padding: 34rpx 28rpx 26rpx;
  box-sizing: border-box;
}

.modal-title {
  color: #222;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.password-text {
  margin: 28rpx 0;
  color: #222;
  font-size: 32rpx;
  line-height: 1.45;
  text-align: center;
  word-break: break-all;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-actions button {
  flex: 1;
}
