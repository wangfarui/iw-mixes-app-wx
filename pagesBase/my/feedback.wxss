.feedback-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.card {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  margin-bottom: 16rpx;
  color: #666666;
  font-size: 26rpx;
  font-weight: 600;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #555555;
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
}

.type-item.active {
  border: 1rpx solid #cfe0ff;
  background: #eef4ff;
  color: #1677ff;
}

.feedback-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.input-counter {
  margin-top: 8rpx;
  color: #999999;
  font-size: 24rpx;
  text-align: right;
}

.contact-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  color: #333333;
  font-size: 28rpx;
}

.contact-tip {
  display: block;
  margin-top: 12rpx;
  color: #999999;
  font-size: 24rpx;
}

.input-placeholder {
  color: #bbbbbb;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.submit-btn.disabled {
  opacity: 0.7;
}

.footer-tip {
  display: block;
  margin-top: 20rpx;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}
