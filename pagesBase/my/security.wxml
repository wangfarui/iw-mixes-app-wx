<view class="security-page">
  <view class="list-card">
    <view class="list-row" bindtap="handleUsername">
      <text class="row-label">用户名</text>
      <view class="row-right">
        <text class="row-value">{{userInfo.username || '-'}}</text>
        <text wx:if="{{userInfo.canEditUsername}}" class="row-arrow">›</text>
      </view>
    </view>
    <view class="list-row" bindtap="handlePhone">
      <text class="row-label">手机号</text>
      <view class="row-right">
        <text class="row-value">{{userInfo.phoneBound ? userInfo.phoneNumber : '未绑定'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <view class="list-row" bindtap="handleEmail">
      <text class="row-label">邮箱</text>
      <view class="row-right">
        <text class="row-value">{{userInfo.emailBound ? userInfo.emailAddress : '未绑定'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <view class="list-row" bindtap="handlePassword">
      <text class="row-label">{{userInfo.hasPassword ? '修改密码' : '设置密码'}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row" wx:if="{{isSuperAdmin}}" bindtap="goRegisterInvite">
      <text class="row-label">新用户注册</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="list-row danger-row" bindtap="handleDeleteAccount">
      <text class="row-label danger-text">注销账号</text>
      <text class="row-arrow danger-arrow">›</text>
    </view>
  </view>
  <text class="danger-tip">注销后原账号及数据将保留，但账号无法恢复登录；手机号、邮箱和用户名可用于新账号。</text>
</view>
