.profile-container {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  background: #f7f8fa;
}

.profile-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 12rpx;
  border: 4rpx solid #eeeeee;
  border-radius: 50%;
  background: #ffffff;
}

.avatar-tip {
  color: #999999;
  font-size: 24rpx;
}

.profile-info-list {
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.profile-info-picker {
  display: block;
}

.profile-info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.profile-info-item:last-child {
  border-bottom: 0;
}

.clickable:active {
  background: #f7f8fa;
}

.profile-info-label {
  color: #666666;
  font-size: 28rpx;
}

.profile-info-value-row {
  display: flex;
  align-items: center;
}

.profile-info-value {
  margin-right: 16rpx;
  color: #222222;
  font-size: 30rpx;
}

.profile-arrow {
  color: #bbbbbb;
  font-size: 36rpx;
}

.modal-mask,
.action-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
}

.modal-mask {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.modal-card {
  width: 100%;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.modal-title {
  margin-bottom: 24rpx;
  color: #222222;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.modal-input {
  height: 80rpx;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.modal-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.modal-btn.secondary {
  background: #f0f1f3;
  color: #555555;
}

.modal-btn.primary {
  background: #07c160;
  color: #ffffff;
}

.modal-btn-active {
  opacity: 0.72;
}

.action-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
}

.action-btn {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #222222;
  font-size: 32rpx;
}

.action-btn.cancel {
  margin-bottom: 0;
  background: #ffffff;
  color: #888888;
  border: 1rpx solid #eeeeee;
}
