.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f7f8fa;
}

.header-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
}

.group-avatar,
.group-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 60rpx;
}

.group-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  font-size: 44rpx;
  font-weight: 600;
}

.group-name {
  margin-bottom: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.group-desc {
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  text-align: center;
}

.member-count {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
}

.member-section,
.action-section {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.member-section {
  padding: 32rpx;
}

.section-title {
  margin-bottom: 24rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: 0;
}

.member-avatar,
.member-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
}

.member-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf7ff;
  color: #1989fa;
  font-size: 28rpx;
  font-weight: 600;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  margin-bottom: 6rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.member-role {
  color: #999;
  font-size: 24rpx;
}

.member-actions {
  display: flex;
  align-items: center;
}

.member-action {
  margin-left: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: #f7f8fa;
}

.member-action-text {
  font-size: 24rpx;
  font-weight: 500;
}

.member-action.role .member-action-text {
  color: #1989fa;
}

.member-action.danger .member-action-text {
  color: #f56c6c;
}

.action-section {
  overflow: hidden;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-btn:last-child {
  border-bottom: 0;
}

.action-btn:active {
  background: #f7f8fa;
}

.action-btn.setting {
  justify-content: space-between;
}

.action-btn.center {
  justify-content: center;
}

.action-text {
  flex: 1;
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
}

.action-right {
  display: flex;
  align-items: center;
}

.action-value {
  margin-right: 8rpx;
  color: #999;
  font-size: 26rpx;
}

.row-arrow {
  color: #c0c4cc;
  font-size: 40rpx;
  line-height: 1;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.action-icon.green {
  background: #07c160;
}

.action-icon.blue {
  background: #1989fa;
}

.setting-tip {
  padding: 0 32rpx 24rpx;
  color: #999;
  font-size: 24rpx;
}

.danger-text {
  flex: none;
  color: #f56c6c;
  font-weight: 600;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  color: #999;
  font-size: 28rpx;
}
