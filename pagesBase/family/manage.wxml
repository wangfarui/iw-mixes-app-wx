<view class="manage-page">
  <view class="section">
    <view class="section-title">基本信息</view>
    <view class="section-card">
      <view class="list-row" bindtap="goEdit">
        <text class="row-label">修改家庭组信息</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="list-row" bindtap="goTransfer">
        <text class="row-label">转让群主</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">邀请管理</view>
    <view class="section-card">
      <view class="list-row" bindtap="goInviteList">
        <text class="row-label">查看邀请码列表</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">危险操作</view>
    <view class="section-card">
      <view class="list-row danger" bindtap="handleDissolve">
        <text class="row-label">解散家庭组</text>
      </view>
    </view>
  </view>
</view>
