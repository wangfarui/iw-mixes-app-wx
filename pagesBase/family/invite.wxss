.invite-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 24rpx;
  background: #f7f8fa;
}

.section-title {
  margin-bottom: 32rpx;
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.period-options {
  display: flex;
  margin-bottom: 64rpx;
}

.period-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #e4e7ed;
  border-radius: 16rpx;
  background: #ffffff;
}

.period-option:last-child {
  margin-right: 0;
}

.period-option.active {
  border-color: #07c160;
  background: #e9f8ef;
}

.option-text {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.period-option.active .option-text {
  color: #07c160;
}

.button-group,
.action-buttons {
  display: flex;
  flex-direction: column;
}

.button-group .btn,
.action-buttons .btn {
  margin-bottom: 16rpx;
}

.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #07c160;
  color: #ffffff;
}

.code-title {
  margin-bottom: 32rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
}

.code-display {
  margin-bottom: 24rpx;
  padding: 32rpx 48rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.18);
}

.code-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.expire-text {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.action-buttons {
  margin-bottom: 32rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.btn::after {
  border: 0;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
}

.btn-secondary {
  border: 2rpx solid #07c160;
  background: #ffffff;
  color: #07c160;
}

.btn-primary[disabled] {
  background: #d8dde3;
  color: #ffffff;
}
