.join-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 24rpx;
  background: #f7f8fa;
}

.header {
  margin-bottom: 56rpx;
  text-align: center;
}

.title {
  margin-bottom: 16rpx;
  color: #222;
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  color: #999;
  font-size: 28rpx;
}

.code-input-section {
  margin-bottom: 48rpx;
}

.code-inputs {
  display: flex;
  justify-content: space-between;
}

.code-input {
  width: 78rpx;
  height: 92rpx;
  box-sizing: border-box;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  background: #ffffff;
  color: #333;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

.preview-section {
  margin-bottom: 48rpx;
}

.preview-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.preview-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.group-avatar,
.group-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 20rpx;
}

.group-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e9f8ef;
  color: #07c160;
  font-size: 36rpx;
  font-weight: 600;
}

.group-info {
  flex: 1;
  min-width: 0;
}

.group-name {
  margin-bottom: 8rpx;
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
}

.group-meta {
  color: #999;
  font-size: 24rpx;
}

.preview-footer {
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.expire-text {
  color: #999;
  font-size: 24rpx;
}

.warning-tip {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fff7e8;
}

.warning-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #ff9f0a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.warning-text {
  flex: 1;
  color: #c97b00;
  font-size: 26rpx;
  line-height: 1.5;
}

.btn-group {
  padding: 0 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.btn::after {
  border: 0;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #d8dde3;
  color: #ffffff;
}
