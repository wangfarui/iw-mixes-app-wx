.form-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f7f8fa;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item.last {
  margin-bottom: 0;
}

.form-label {
  margin-bottom: 16rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.required {
  color: #f56c6c;
}

.avatar-upload {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-icon {
  color: #07c160;
  font-size: 52rpx;
  line-height: 1;
}

.placeholder-text {
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 28rpx;
}

.btn-group {
  padding: 0 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.btn::after {
  border: 0;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #d8dde3;
  color: #ffffff;
}
